APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# Runtime mode profile:
# - local-demo: mock providers + demo bootstrap workflows
# - trial: real providers + no mock fallback
APP_RUNTIME_MODE=local-demo

MYSQL_DATABASE=ai_store_manager
MYSQL_USER=aism
MYSQL_PASSWORD=aism_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DEFAULT_SHOP_ID=shop_default
DEFAULT_OWNER_ACTOR_ID=owner_default
DEFAULT_SESSION_ID=sess_default
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=dev-password

# Local-demo defaults (safe for smoke/demo tooling).
OBJECT_STORAGE_PROVIDER=mock
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=900

ASR_PROVIDER=mock
ASR_PROVIDER_API_URL=
ASR_PROVIDER_API_KEY=
ASR_PROVIDER_MODEL=
ASR_TIMEOUT_SECONDS=15
ASR_ALLOW_MOCK_FALLBACK=1

OCR_PROVIDER=mock
OCR_PROVIDER_API_URL=
OCR_PROVIDER_API_KEY=
OCR_PROVIDER_MODEL=
OCR_TIMEOUT_SECONDS=15
OCR_ALLOW_MOCK_FALLBACK=1

VISION_PROVIDER=mock
VISION_PROVIDER_API_URL=
VISION_PROVIDER_API_KEY=
VISION_PROVIDER_MODEL=
VISION_TIMEOUT_SECONDS=15
VISION_ALLOW_MOCK_FALLBACK=1
TRIAL_PROVIDER_PROFILE=
ASR_PROVIDER_LABEL=
OCR_PROVIDER_LABEL=
VISION_PROVIDER_LABEL=
TRIAL_CALIBRATION_DATASET_DIR=
TRIAL_CALIBRATION_ARTIFACTS_DIR=

