# Business backend environment example
# Do not commit real API keys. Use deployment secrets or local .env only.

# Runtime
APP_ENV=development
APP_RUNTIME_MODE=local-demo
APP_HOST=0.0.0.0
APP_PORT=8001
DATABASE_URL=sqlite:///./business.db
REDIS_URL=redis://redis:6379/0

# LLM Configuration - DeepSeek official API as primary Main Agent
LLM_PROVIDER=deepseek
LLM_PROVIDER_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.2
LLM_ALLOW_MOCK_FALLBACK=0

# Volcano Ark / Doubao multimodal configuration
# Tested target model: doubao-seed-2-0-pro-260215
# API URL uses OpenAI-compatible chat/completions.
ARK_CHAT_COMPLETIONS_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_API_KEY=
ARK_MULTIMODAL_MODEL=doubao-seed-2-0-pro-260215

# OCR via Doubao Vision/OCR prompt
OCR_PROVIDER=volcano
OCR_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
OCR_PROVIDER_API_KEY=${ARK_API_KEY}
OCR_PROVIDER_MODEL=${ARK_MULTIMODAL_MODEL}
OCR_TIMEOUT_SECONDS=45
OCR_ALLOW_MOCK_FALLBACK=0

# Vision via Doubao image understanding prompt
VISION_PROVIDER=volcano
VISION_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VISION_PROVIDER_API_KEY=${ARK_API_KEY}
VISION_PROVIDER_MODEL=${ARK_MULTIMODAL_MODEL}
VISION_TIMEOUT_SECONDS=45
VISION_ALLOW_MOCK_FALLBACK=0

# ASR experimental path via Doubao input_audio chat content.
# Note: verify your Ark model/endpoint supports input_audio before enabling in production.
ASR_PROVIDER=volcano
ASR_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ASR_PROVIDER_API_KEY=${ARK_API_KEY}
ASR_PROVIDER_MODEL=${ARK_MULTIMODAL_MODEL}
ASR_TIMEOUT_SECONDS=45
ASR_ALLOW_MOCK_FALLBACK=0

# Demo Mode fallback (only for local demos)
# ASR_PROVIDER=mock
# OCR_PROVIDER=mock
# VISION_PROVIDER=mock
# ASR_ALLOW_MOCK_FALLBACK=1
# OCR_ALLOW_MOCK_FALLBACK=1
# VISION_ALLOW_MOCK_FALLBACK=1
