{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/provider-calibration/manifest.schema.json",
  "title": "Pilot Calibration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_id",
    "cases"
  ],
  "properties": {
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "capability",
          "media_path",
          "expected"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "enum": [
              "asr",
              "ocr",
              "vision"
            ]
          },
          "media_path": {
            "type": "string",
            "minLength": 1
          },
          "media_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "type": "object"
          }
        }
      }
    }
  }
}
