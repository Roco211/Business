# Volcano Engine Configuration for Business Project
# 火山引擎配置 - Phase 8 LLM Integration

# ASR Configuration
ASR_PROVIDER=volcano
ASR_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/audio/quick-digest
ASR_PROVIDER_API_KEY=${VOLCANO_API_KEY}
ASR_PROVIDER_MODEL=ep-20260416043519-v4vzq
ASR_TIMEOUT_SECONDS=15
ASR_ALLOW_MOCK_FALLBACK=1

# OCR Configuration
OCR_PROVIDER=volcano
OCR_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/ocr/receipt
OCR_PROVIDER_API_KEY=${VOLCANO_API_KEY}
OCR_PROVIDER_MODEL=ep-20260416043519-v4vzq
OCR_TIMEOUT_SECONDS=15
OCR_ALLOW_MOCK_FALLBACK=1

# Vision Configuration
VISION_PROVIDER=volcano
VISION_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VISION_PROVIDER_API_KEY=${VOLCANO_API_KEY}
VISION_PROVIDER_MODEL=ep-20260416043519-v4vzq
VISION_TIMEOUT_SECONDS=15
VISION_ALLOW_MOCK_FALLBACK=1

# LLM Configuration - DeepSeek 官方 API
LLM_PROVIDER=deepseek
LLM_PROVIDER_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.2
LLM_ALLOW_MOCK_FALLBACK=0

# Demo Mode (no real ASR/OCR/Vision keys needed)
# ASR_PROVIDER=mock
# OCR_PROVIDER=mock
# VISION_PROVIDER=mock
