APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
APP_RUNTIME_MODE=trial

MYSQL_DATABASE=ai_store_manager
MYSQL_USER=aism
MYSQL_PASSWORD=aism_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

DEFAULT_SHOP_ID=shop_default
DEFAULT_OWNER_ACTOR_ID=owner_default
DEFAULT_SESSION_ID=sess_default
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=dev-password

# Trial provider profile metadata checklist.
TRIAL_PROVIDER_PROFILE=pilot-v1
ASR_PROVIDER_LABEL=asr-primary
OCR_PROVIDER_LABEL=ocr-primary
VISION_PROVIDER_LABEL=vision-primary
TRIAL_CALIBRATION_DATASET_DIR=/srv/pilot/calibration/datasets/v1
TRIAL_CALIBRATION_ARTIFACTS_DIR=/srv/pilot/calibration/artifacts/v1
LIVE_PILOT_ALLOWED_SHOP_IDS=shop_default

OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_BUCKET=trial-bucket
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_ENDPOINT_URL=https://s3.example.com
OBJECT_STORAGE_ACCESS_KEY=trial-access-key-placeholder
OBJECT_STORAGE_SECRET_KEY=trial-secret-key-placeholder
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=900

ASR_PROVIDER=real-provider
ASR_PROVIDER_API_URL=https://asr.example.com/v1/transcriptions
ASR_PROVIDER_API_KEY=trial-asr-api-key-placeholder
ASR_PROVIDER_MODEL=asr-model-v1
ASR_TIMEOUT_SECONDS=15
ASR_ALLOW_MOCK_FALLBACK=0

OCR_PROVIDER=real-provider
OCR_PROVIDER_API_URL=https://ocr.example.com/v1/receipts
OCR_PROVIDER_API_KEY=trial-ocr-api-key-placeholder
OCR_PROVIDER_MODEL=ocr-model-v1
OCR_TIMEOUT_SECONDS=15
OCR_ALLOW_MOCK_FALLBACK=0

VISION_PROVIDER=real-provider
VISION_PROVIDER_API_URL=https://vision.example.com/v1/recognize
VISION_PROVIDER_API_KEY=trial-vision-api-key-placeholder
VISION_PROVIDER_MODEL=vision-model-v1
VISION_TIMEOUT_SECONDS=15
VISION_ALLOW_MOCK_FALLBACK=0
