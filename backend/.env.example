# Business backend environment example
# Do not commit real API keys. Use deployment secrets or local .env only.

# Runtime
APP_ENV=development
APP_RUNTIME_MODE=local-demo
APP_HOST=0.0.0.0
APP_PORT=8001
DATABASE_URL=sqlite:///./business.db
REDIS_URL=redis://redis:6379/0

# Object Storage - production uses S3-compatible storage such as Volcano TOS / Aliyun OSS / Tencent COS.
# Do not commit real credentials. Inject them via deployment secrets or local .env only.
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_BUCKET=business-prod-media
OBJECT_STORAGE_ENDPOINT_URL=https://tos-cn-beijing.volces.com
OBJECT_STORAGE_REGION=cn-beijing
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=600
# Local demo only:
# OBJECT_STORAGE_PROVIDER=mock

# SMS verification - production must use a real provider.
SMS_PROVIDER=volcengine
SMS_API_URL=
SMS_ACCESS_KEY_ID=
SMS_SECRET_ACCESS_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_CODE_TTL_SECONDS=300
# Local demo only:
# SMS_PROVIDER=demo

# LLM Configuration - DeepSeek official API as primary Main Agent
LLM_PROVIDER=deepseek
LLM_PROVIDER_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.2
LLM_ALLOW_MOCK_FALLBACK=0

# Volcano Ark / Doubao multimodal configuration
# Tested target model: doubao-seed-2-0-pro-260215
# API URL uses OpenAI-compatible chat/completions.
ARK_CHAT_COMPLETIONS_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_API_KEY=
ARK_MULTIMODAL_MODEL=doubao-seed-2-0-pro-260215

# OCR via Doubao Vision/OCR prompt
OCR_PROVIDER=volcano
OCR_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
OCR_PROVIDER_API_KEY=
OCR_PROVIDER_MODEL=doubao-seed-2-0-pro-260215
OCR_TIMEOUT_SECONDS=45
OCR_ALLOW_MOCK_FALLBACK=0

# Vision via Doubao image understanding prompt
VISION_PROVIDER=volcano
VISION_PROVIDER_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VISION_PROVIDER_API_KEY=
VISION_PROVIDER_MODEL=doubao-seed-2-0-pro-260215
VISION_TIMEOUT_SECONDS=45
VISION_ALLOW_MOCK_FALLBACK=0

# ASR: P0 production recommendation is client-side ASR text input.
ASR_PROVIDER=client
ASR_PROVIDER_API_URL=
ASR_PROVIDER_API_KEY=
ASR_PROVIDER_MODEL=
ASR_TIMEOUT_SECONDS=45
ASR_ALLOW_MOCK_FALLBACK=0

# Demo Mode fallback (only for local demos)
# ASR_PROVIDER=mock
# OCR_PROVIDER=mock
# VISION_PROVIDER=mock
# ASR_ALLOW_MOCK_FALLBACK=1
# OCR_ALLOW_MOCK_FALLBACK=1
# VISION_ALLOW_MOCK_FALLBACK=1
