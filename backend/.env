# Trial Provider Profile Configuration
TRIAL_PROVIDER_PROFILE=mock_trial_profile
ASR_PROVIDER_LABEL=volcano
OCR_PROVIDER_LABEL=volcano
VISION_PROVIDER_LABEL=volcano
TRIAL_CALIBRATION_DATASET_DIR=/tmp/calibration
TRIAL_CALIBRATION_ARTIFACTS_DIR=/tmp/artifacts
LIVE_PILOT_ALLOWED_SHOP_IDS=shop_default

# Runtime Mode
APP_RUNTIME_MODE=local-demo

# Database - SQLite for testing
DATABASE_URL=sqlite:///./aism-dev.db

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_PROVIDER_API_URL=https://gptrr.qzz.io/v1/chat/completions
LLM_PROVIDER_API_KEY=${LLM_API_KEY}
LLM_PROVIDER_MODEL=kimi-k2.6
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_ALLOW_MOCK_FALLBACK=1

# ASR Provider (语音识别) - 使用 mock 进行 trial 测试
ASR_PROVIDER=mock
ASR_PROVIDER_API_URL=
ASR_PROVIDER_API_KEY=
ASR_PROVIDER_MODEL=
ASR_TIMEOUT_SECONDS=30
ASR_ALLOW_MOCK_FALLBACK=1

# OCR Provider (图片文字识别) - 使用 mock 进行 trial 测试
OCR_PROVIDER=mock
OCR_PROVIDER_API_URL=
OCR_PROVIDER_API_KEY=
OCR_PROVIDER_MODEL=
OCR_TIMEOUT_SECONDS=30
OCR_ALLOW_MOCK_FALLBACK=1

# Vision Provider (图片识别) - 使用 mock 进行 trial 测试
VISION_PROVIDER=mock
VISION_PROVIDER_API_URL=
VISION_PROVIDER_API_KEY=
VISION_PROVIDER_MODEL=
VISION_TIMEOUT_SECONDS=30
VISION_ALLOW_MOCK_FALLBACK=1
